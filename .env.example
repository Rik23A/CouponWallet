# CouponVault Server — Environment Variables
# Copy this to .env and fill in real values

# Server
PORT=3000
NODE_ENV=production

# CORS — comma-separated allowed origins
# For dev use: *
# For prod use: your app bundle origin or leave * for React Native
ALLOWED_ORIGINS=*

# MongoDB Atlas connection string (native driver — NOT Data API)
# Format: mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/couponvault?retryWrites=true&w=majority
MONGODB_DB=couponvault

# Google Gemini API Key
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60

# JWT Secret
JWT_SECRET=your_super_secret_jwt_key_here

# Mailer — SMTP Configuration (Gmail Setup Template)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_gmail_address@gmail.com
SMTP_PASS=your_16_character_app_password
SMTP_FROM="CouponVault" <your_gmail_address@gmail.com>
